# Medtrax web app configuration
# Copy this file to .env and fill in real values.
# Cognito/runtime/KB IDs can be found via `terraform output` in infra/mtx/ after `terraform apply`.

AWS_REGION="us-east-1"
# Optional named AWS CLI/SSO profile for S3 + Bedrock IAM calls (blank = default credential chain)
AWS_PROFILE=""

# Cognito - public app client, no secret (infra/mtx/cognito.tf)
COGNITO_USER_POOL_ID="us-east-1_XXXXXXXXX"
COGNITO_CLIENT_ID=""

# AgentCore Runtime - full ARN (infra/mtx/agentcore_runtime.tf)
AGENTCORE_RUNTIME_ARN="arn:aws:bedrock-agentcore:us-east-1:XXXXXXXXXXXX:runtime/medtrax-dev-runtime-XXXXXXXXXXX"

# Bedrock Knowledge Base (infra/mtx/bedrock_kb.tf) - use `terraform output` after applying
S3_DATA_SOURCE_BUCKET="medtrax-dev-source-bucket"
BEDROCK_KNOWLEDGE_BASE_ID=""
BEDROCK_DATA_SOURCE_ID=""

# Set to "true" to show a Debug section in the sidebar (e.g. the logged-in user's sub)
DEBUG="false"
